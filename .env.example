# Copy this file to .env and fill in your own password.
# .env is gitignored and never committed; this template is.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=echo
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Hosted Postgres for a deployed instance. Optional locally — the DB_* values
# above take priority whenever DB_HOST is set, so having this line present does
# not point local scripts at production.
# NEON_POSTGRES_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
